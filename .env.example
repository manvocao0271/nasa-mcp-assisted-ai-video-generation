# Required — get a free key at https://api.nasa.gov
NASA_API_KEY=your_nasa_api_key_here

# Required — Qwen Cloud / DashScope API key (https://www.qwencloud.com)
QWEN_API_KEY=your_qwen_api_key_here

# Optional — MCP server cache location (default: ~/.cache/nasa-mcp/cache.sqlite3)
# NASA_MCP_CACHE_PATH=

# Optional — HTTP timeout in seconds for NASA API calls (default: 30)
# NASA_MCP_TIMEOUT=30

QWEN_MODEL_VISION=qwen3-vl-plus

# Optional — show Streamlit debug panel in sidebar (default off)
# DEBUG=1
